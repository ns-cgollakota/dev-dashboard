# Jira Cloud
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Confluence Cloud (usually same instance/token as Jira)
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
# Your Atlassian account ID (find it at: yourcompany.atlassian.net/rest/api/3/myself)
CONFLUENCE_ACCOUNT_ID=your_atlassian_account_id_here

# GitHub
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ── Public vars (safe to expose in client JS — no secrets) ──────────────────
# These are used by the React app to build deep links.
VITE_JIRA_BASE_URL=https://yourcompany.atlassian.net
VITE_CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
VITE_GITHUB_USERNAME=your_github_username
# Optional: restrict GitHub PRs to a specific org (e.g. ns-sshukla)
VITE_GITHUB_ORG=your_github_org
